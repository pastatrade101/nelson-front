# Frontend env — copy to .env. Only PUBLIC_* vars reach the browser.

# Backend API base URL (with /api). Leave blank for same-domain (auto-uses /api).
PUBLIC_API_URL=http://localhost:5000/api

# Public site origin for canonical URLs, OG tags, sitemap and robots.
PUBLIC_SITE_URL=http://localhost:5173

# GA4 Measurement ID (e.g. G-XXXXXXXXXX). Set to load gtag on the public site so
# analytics events also reach GA4. Leave blank to keep first-party tracking only.
# NOTE: add a cookie-consent banner before enabling this for EU visitors.
PUBLIC_GA4_MEASUREMENT_ID=

# Set to "true" to resize Supabase-storage images via the render/image transform
# (requires Supabase image transformations — a paid feature). Unsplash images are
# always sized regardless. Leave blank/false to serve uploaded images as-is.
PUBLIC_SUPABASE_IMG_TRANSFORM=

# Cloudflare Turnstile site key for the built-in Emnel AI Advisor's human check.
# REQUIRED when the backend has TURNSTILE_SECRET_KEY set — otherwise /ai/chat
# returns 403 and the advisor can't reply. Use the site key paired with that
# secret (Cloudflare dashboard → Turnstile). To disable the challenge instead,
# leave this blank AND unset TURNSTILE_SECRET_KEY on the backend.
PUBLIC_TURNSTILE_SITE_KEY=

# (Legacy) External Makutano AI widget — no longer loaded; the site uses the
# built-in Emnel AI Advisor. Kept for reference only.
PUBLIC_MAKUTANO_WIDGET_URL=https://ai.makutano.co.tz/widget.js
PUBLIC_MAKUTANO_CLIENT=emnel-adventures
